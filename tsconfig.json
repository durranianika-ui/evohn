{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  /*
   * `vitest.config.mts` is excluded because Vitest bundles its own copy of
   * Vite, and the plugin types from the hoisted Vite are structurally
   * incompatible with the nested one. The mismatch is between two build
   * tools' type declarations, not in any code that ships; Vitest reads the
   * file with its own resolution and is unaffected.
   */
  "exclude": ["node_modules", "vitest.config.mts"]
}
